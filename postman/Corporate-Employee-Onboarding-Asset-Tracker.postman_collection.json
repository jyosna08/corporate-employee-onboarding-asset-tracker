{
  "info": {
    "_postman_id": "f148d7db-e59f-4b77-8ef6-09e77ad90c02",
    "name": "Corporate Employee Onboarding & Asset Tracker API",
    "description": "Complete collection for auth, employees, assets (including maintenance resolve), and dashboard. Run Register HR account once, then HR Login and IT Login before requests that use their tokens. Registration saves its credentials for HR Login. Create requests write to your database; use unique test values. Auth Service Health calls the service directly and requires that service to be reachable at authServiceUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{hrToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register HR account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/auth/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman HR\",\n  \"email\": \"{{registrationEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Registration returns a user\", function () { pm.expect(data.email).to.eql(pm.environment.get('registrationEmail')); });",
                  "pm.environment.set('hrEmail', pm.environment.get('registrationEmail'));",
                  "pm.environment.set('hrPassword', pm.environment.get('registrationPassword'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as HR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{hrEmail}}\",\n  \"password\": \"{{hrPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Login returns an access token\", function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.environment.set(\"hrToken\", data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as IT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{itEmail}}\",\n  \"password\": \"{{itPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Login returns an access token\", function () { pm.expect(data.accessToken).to.be.a('string').and.not.empty; });",
                  "pm.environment.set(\"itToken\", data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
  {
    "name": "Auth Service Health (direct service URL)",
    "request": {
      "method": "GET",
      "header": [],
      "auth": {
        "type": "noauth"
      },
      "url": "{{authServiceUrl}}/api/auth/health"
    },
    "event": [
      {
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Auth service health returns no content', function () { pm.response.to.have.status(204); });"
          ]
        }
      }
    ]
  },
    {
      "name": "02 Employees (HR unless noted)",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/employees",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeNumber\": \"{{employeeNumber}}\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"email\": \"{{employeeEmail}}\",\n  \"jobTitle\": \"Product Designer\",\n  \"department\": \"Design\",\n  \"managerName\": \"Maya Chen\",\n  \"startDate\": \"2026-12-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Employee is created\", function () { pm.expect(data.id).to.be.a('string').and.not.empty; });",
                  "pm.environment.set(\"employeeId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/employees?search={{employeeSearch}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns an employee list\", function () { pm.expect(data).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get employee",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/employees/{{employeeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns the selected employee\", function () { pm.expect(data.id).to.eql(pm.environment.get('employeeId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/employees/{{employeeId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"email\": \"{{employeeEmail}}\",\n  \"jobTitle\": \"Senior Product Designer\",\n  \"department\": \"Design\",\n  \"managerName\": \"Maya Chen\",\n  \"startDate\": \"2026-12-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Updated job title is returned\", function () { pm.expect(data.jobTitle).to.eql('Senior Product Designer'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Advance onboarding",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{apiUrl}}/api/employees/{{employeeId}}/onboarding/advance"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Onboarding stage advances\", function () { pm.expect(data.onboardingStatus).to.be.oneOf(['IN_PROGRESS','VERIFIED']); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update employment status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/employees/{{employeeId}}/employment-status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Employment status is returned\", function () { pm.expect(data.employmentStatus).to.eql('ACTIVE'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update system sync (IT)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/employees/{{employeeId}}/system-sync/SLACK",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{itToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SYNCED\",\n  \"failureMessage\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Employee sync state is returned\", function () { pm.expect(data.systemSyncs).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Assets",
      "item": [
        {
          "name": "Create asset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/assets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetTag\": \"{{assetTag}}\",\n  \"type\": \"LAPTOP\",\n  \"hardwareSpecs\": \"16 GB RAM, 512 GB SSD\",\n  \"purchaseDate\": \"2026-10-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Asset is created\", function () { pm.expect(data.id).to.be.a('string').and.not.empty; });",
                  "pm.environment.set(\"assetId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List assets",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/assets?status=AVAILABLE&type=LAPTOP&page=0&size=20&sort=assetTag,asc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns a page of assets\", function () { pm.expect(data.content).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get asset",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/assets/{{assetId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns the selected asset\", function () { pm.expect(data.id).to.eql(pm.environment.get('assetId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update asset",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/assets/{{assetId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetTag\": \"{{assetTag}}\",\n  \"type\": \"LAPTOP\",\n  \"hardwareSpecs\": \"32 GB RAM, 1 TB SSD\",\n  \"purchaseDate\": \"2026-10-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Updated asset specs are returned\", function () { pm.expect(data.hardwareSpecs).to.include('32 GB RAM'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign asset to employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/assets/{{assetId}}/assignments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employeeId\": \"{{employeeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Assignment points to the employee\", function () { pm.expect(data.employeeId).to.eql(pm.environment.get('employeeId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get assignment history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/assets/{{assetId}}/assignments?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returns a page of assignment history\", function () { pm.expect(data.content).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Return asset",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{apiUrl}}/api/assets/{{assetId}}/return"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Returned asset is available\", function () { pm.expect(data.lifecycleStatus).to.eql('AVAILABLE'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark asset for maintenance (IT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apiUrl}}/api/assets/{{assetId}}/maintenance",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{itToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman maintenance check\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Asset enters maintenance\", function () { pm.expect(data.lifecycleStatus).to.eql('MAINTENANCE_ALERT'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Resolve asset maintenance (IT)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{apiUrl}}/api/assets/{{assetId}}/maintenance/resolve",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{itToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Asset returns to available inventory\", function () { pm.expect(data.lifecycleStatus).to.eql('AVAILABLE'); pm.expect(data.maintenanceReason).to.eql(null); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Dashboard",
      "item": [
        {
          "name": "Get dashboard overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apiUrl}}/api/dashboard/overview"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Dashboard has onboarding, sync, and asset counts\", function () { pm.expect(data).to.have.property('employeesByOnboardingStatus'); pm.expect(data).to.have.property('systemSync'); pm.expect(data).to.have.property('assetsByLifecycleStatus'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
